<Window x:Class="IslaDinamica.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Isla Dinámica" Width="440" Height="230"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="Dim" Color="#99FFFFFF"/>
        <SolidColorBrush x:Key="Track" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="ArtPlaceholder" Color="#2A2A2A"/>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="6,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Text" Value="—"/>
        </Style>
        <Style x:Key="MetricSub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Text" Value=" "/>
        </Style>
        <Style x:Key="MetricGraph" TargetType="Polyline">
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <!-- La isla va pegada al borde superior (estilo notch): esquinas de arriba rectas,
         "orejas" cóncavas que la unen a la pantalla y esquinas de abajo redondeadas -->
    <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
    <Path HorizontalAlignment="Left" VerticalAlignment="Top" Fill="Black"
          Data="M0,0 L12,0 L12,12 A12,12 0 0 0 0,0 Z"/>
    <Path HorizontalAlignment="Right" VerticalAlignment="Top" Fill="Black"
          Data="M12,0 L0,0 L0,12 A12,12 0 0 1 12,0 Z"/>
    <Border x:Name="Pill" Background="Black" CornerRadius="0,0,16,16"
            Width="130" Height="34" Margin="12,0"
            HorizontalAlignment="Center" VerticalAlignment="Top" ClipToBounds="True"
            MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave"
            MouseLeftButtonUp="Pill_MouseLeftButtonUp" MouseWheel="Pill_MouseWheel">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Salir" Click="Exit_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <!-- Reposo: reloj -->
            <TextBlock x:Name="IdleView" Foreground="White" FontSize="13" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Compacta: carátula + visualizador -->
            <Grid x:Name="CompactView" Width="250" Height="36" VerticalAlignment="Top"
                  Visibility="Collapsed" Opacity="0">
                <Border Width="22" Height="22" CornerRadius="6" Margin="14,0,0,0"
                        HorizontalAlignment="Left" Background="{StaticResource ArtPlaceholder}">
                    <Border CornerRadius="6">
                        <Border.Background>
                            <ImageBrush x:Name="CompactArt" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Border>
                <StackPanel x:Name="CompactBars" Orientation="Horizontal" Margin="0,0,16,0"
                            HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Página expandida: música -->
            <Grid x:Name="MusicView" Width="348" Margin="0,16,0,0" VerticalAlignment="Top"
                  Visibility="Collapsed" Opacity="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="12" Background="{StaticResource ArtPlaceholder}">
                        <Border CornerRadius="12">
                            <Border.Background>
                                <ImageBrush x:Name="ExpandedArt" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                        <TextBlock x:Name="TitleText" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ArtistText" Foreground="{StaticResource Dim}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="ExpandedBars" Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,4,0"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PositionText" Foreground="{StaticResource Dim}" FontSize="11"
                               VerticalAlignment="Center"/>
                    <Grid x:Name="ProgressTrack" Grid.Column="1" Height="14" Margin="4,0"
                          Background="Transparent" Cursor="Hand" MouseLeftButtonDown="Progress_MouseDown">
                        <Border Height="4" CornerRadius="2" Background="{StaticResource Track}"/>
                        <Border Height="4" CornerRadius="2" Background="White" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ProgressScale" ScaleX="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="DurationText" Grid.Column="2" Foreground="{StaticResource Dim}" FontSize="11"
                               VerticalAlignment="Center" TextAlignment="Right"/>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="Previous_Click"/>
                    <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" FontSize="20"
                            Content="&#xE768;" Click="PlayPause_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next_Click"/>
                </StackPanel>
            </Grid>

            <!-- Página expandida: monitor del sistema -->
            <UniformGrid x:Name="SystemView" Columns="3" Width="348" Margin="0,16,0,0" VerticalAlignment="Top"
                         Visibility="Collapsed" Opacity="0">
                <StackPanel Margin="4,0">
                    <TextBlock Style="{StaticResource MetricLabel}" Text="CPU"/>
                    <TextBlock x:Name="CpuText" Style="{StaticResource MetricValue}"/>
                    <TextBlock x:Name="CpuSub" Style="{StaticResource MetricSub}"/>
                    <Polyline x:Name="CpuGraph" Style="{StaticResource MetricGraph}" Stroke="#0A84FF"/>
                </StackPanel>
                <StackPanel Margin="4,0">
                    <TextBlock Style="{StaticResource MetricLabel}" Text="RAM"/>
                    <TextBlock x:Name="RamText" Style="{StaticResource MetricValue}"/>
                    <TextBlock x:Name="RamSub" Style="{StaticResource MetricSub}"/>
                    <Polyline x:Name="RamGraph" Style="{StaticResource MetricGraph}" Stroke="#BF5AF2"/>
                </StackPanel>
                <StackPanel Margin="4,0">
                    <TextBlock Style="{StaticResource MetricLabel}" Text="GPU"/>
                    <TextBlock x:Name="GpuText" Style="{StaticResource MetricValue}"/>
                    <TextBlock x:Name="GpuSub" Style="{StaticResource MetricSub}" Text="3D"/>
                    <Polyline x:Name="GpuGraph" Style="{StaticResource MetricGraph}" Stroke="#30D158"/>
                </StackPanel>
            </UniformGrid>

            <!-- Página expandida: historial del portapapeles -->
            <Grid x:Name="ClipboardView" Width="348" Margin="0,12,0,0" VerticalAlignment="Top"
                  Visibility="Collapsed" Opacity="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Height="20">
                    <TextBlock Text="Portapapeles" Style="{StaticResource MetricLabel}" VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                    <Button x:Name="ClearClipboardButton" Style="{StaticResource TextButton}" Content="Borrar"
                            HorizontalAlignment="Right" Click="ClearClipboardHistory_Click"/>
                </Grid>
                <StackPanel x:Name="ClipboardList" Grid.Row="1" Margin="0,6,0,0"/>
            </Grid>

            <!-- Página expandida: próximos eventos del calendario -->
            <Grid x:Name="AgendaView" Width="348" Margin="0,12,0,0" VerticalAlignment="Top"
                  Visibility="Collapsed" Opacity="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Height="20">
                    <TextBlock Text="Agenda" Style="{StaticResource MetricLabel}" VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                    <TextBlock x:Name="AgendaDate" Style="{StaticResource MetricLabel}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="0,0,4,0"/>
                </Grid>
                <StackPanel x:Name="AgendaList" Grid.Row="1" Margin="0,6,0,0"/>
            </Grid>

            <!-- Notificación -->
            <Grid x:Name="NotificationView" Width="370" Height="76" VerticalAlignment="Top"
                  Visibility="Collapsed" Opacity="0" Cursor="Hand">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid Width="40" Height="40" Margin="18,0,0,0">
                    <Border x:Name="NotificationPlaceholder" CornerRadius="10" Background="#333333">
                        <TextBlock x:Name="NotificationInitial" Foreground="White" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border CornerRadius="10">
                        <Border.Background>
                            <ImageBrush x:Name="NotificationIcon" Stretch="Uniform"/>
                        </Border.Background>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,24,0">
                    <TextBlock x:Name="NotificationApp" Foreground="{StaticResource Dim}" FontSize="11"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="NotificationTitle" Foreground="White" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="NotificationBody" Foreground="#CCFFFFFF" FontSize="12"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <!-- Aviso de "Copiado" -->
            <Grid x:Name="ClipToastView" Width="300" Height="40" VerticalAlignment="Top"
                  Visibility="Collapsed" Opacity="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid Width="26" Height="26" Margin="8,0,0,0">
                    <Border x:Name="ClipToastCheck" CornerRadius="13" Background="#30D158">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE73E;" Foreground="Black" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="ClipToastThumb" CornerRadius="6" Visibility="Collapsed">
                        <Border.Background>
                            <ImageBrush x:Name="ClipToastImage" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,18,0">
                    <TextBlock Text="Copiado" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ClipToastText" Foreground="{StaticResource Dim}" FontSize="12" Margin="8,0,0,0"
                               MaxWidth="190" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Volumen -->
            <Grid x:Name="VolumeView" Width="260" Height="36" VerticalAlignment="Top"
                  Visibility="Collapsed" Opacity="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="VolumeIcon" FontFamily="{StaticResource Icons}" Foreground="White"
                           FontSize="14" Width="18" Margin="16,0,0,0" VerticalAlignment="Center"/>
                <Grid Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                    <Border Height="4" CornerRadius="2" Background="{StaticResource Track}"/>
                    <Border Height="4" CornerRadius="2" Background="White" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="VolumeScale" ScaleX="0"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
                <TextBlock x:Name="VolumeText" Grid.Column="2" Foreground="{StaticResource Dim}" FontSize="11"
                           Width="24" Margin="0,0,16,0" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Indicador de página (rueda del mouse para cambiar) -->
            <StackPanel x:Name="PageDots" Orientation="Horizontal" HorizontalAlignment="Center"
                        VerticalAlignment="Bottom" Margin="0,0,0,10" Visibility="Collapsed"/>
        </Grid>
    </Border>
    </Grid>
</Window>
